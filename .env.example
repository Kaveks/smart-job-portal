# Shared PostgreSQL credentials
DB_USERNAME=smartjobs
DB_PASSWORD=CHANGE_ME

# JPA / Hibernate Configuration
JPA_DDL_AUTO=update

#jwt, used in prod or docker/kubernetes
JWT_KEY_DIRECTORY=/var/lib/smart-job-portal/keys

# User Service
USER_SERVICE_PORT=8081
USER_DB_URL=jdbc:postgresql://localhost:5432/smart_job_user

# Company Service
COMPANY_SERVICE_PORT=8082
COMPANY_DB_URL=jdbc:postgresql://localhost:5432/smart_job_company

# Job Service
JOB_SERVICE_PORT=8083
JOB_DB_URL=jdbc:postgresql://localhost:5432/smart_job_job

# Resume Service
RESUME_SERVICE_PORT=8084
RESUME_DB_URL=jdbc:postgresql://localhost:5432/smart_job_resume

# Application Service
APPLICATION_SERVICE_PORT=8085
APPLICATION_DB_URL=jdbc:postgresql://localhost:5432/smart_job_application

# Preference Service
PREFERENCE_SERVICE_PORT=8086
PREFERENCE_DB_URL=jdbc:postgresql://localhost:5432/smart_job_preference

# AI Service
AI_SERVICE_PORT=8087
AI_DB_URL=jdbc:postgresql://localhost:5432/smart_job_ai

# Notification Service
NOTIFICATION_SERVICE_PORT=8088
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/smart_job_notification

# Infrastructure
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_SERVER_URL=http://localhost:8761/eureka/